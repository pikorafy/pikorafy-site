# API keys for the importers in Docker (the "jobs" service). Copy this file to
# docker/importers.env and fill in the keys you have; git never picks that file up.
# An importer whose keys are empty is skipped. Get the keys from each service's own
# dashboard (GitHub Actions secrets can't be read back).

STEAM_API_KEY=
ITAD_API_KEY=
IGDB_CLIENT_ID=
IGDB_CLIENT_SECRET=
# Only needed for the optional OpenXBL lists (off by default).
OPENXBL_API_KEY=

# Catalog size: everything by default. Optional limits, e.g. to try things on a smaller set:
# MAX_GAMES=5000            Nintendo and PlayStation: games tracked, most popular first
# STEAM_PER_RUN=15000       Steam games imported or refreshed per run (every 3h)
# STORE_PAGES=1000          PlayStation store pages read per run (~2.5 s each); 3000 fills faster
# ITAD_MAX_PRICES=          IsThereAnyDeal: games whose prices are refreshed per run
# RELEASES_PER_MONTH=1000   release calendar games kept per month
